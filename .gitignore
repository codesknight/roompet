# ---------------------------------------------------------------- Unity generated
# These are rebuilt from Assets/ + ProjectSettings/ on first open. Committing them
# adds tens of MB and nothing but merge conflicts.
#
# NOTE: patterns are deliberately NOT anchored with a leading slash â€?the Unity
# project lives in UnityMCPProject/, one level below the repository root, so
# "/[Ll]ibrary/" would miss it entirely.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity writes these into the project root; the IDE regenerates them.
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Editor / IDE state
.vs/
.idea/
.vscode/
.consulo/

# Python bytecode (scripts/ holds a few helper scripts)
__pycache__/
*.pyc

# Build output
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# ------------------------------------------------------- this project's own bits
# The MCP for Unity checkout and its Python environment are machine-level dev
# tooling, not part of the game. See docs/MCP_SETUP.md to recreate them.
/unity-mcp/
/.venv/
/.tools/
/.unity-mcp-status/

# Scratch captures. Evidence worth keeping goes to docs/evidence/ instead.
/logs/
UnityMCPProject/Assets/Screenshots/
UnityMCPProject/Assets/Screenshots.meta

# Player builds. Tools/DSH Mobile/Build APK writes here; an APK is an artifact,
# not source â€?the copy people install belongs in a GitHub Release.
UnityMCPProject/Builds/

# The icon contact sheet is a development aid, regenerated by
# Tools/DSH Mobile/Icons/Render Size Preview Sheet. The four icon layers themselves ARE
# committed: PlayerSettings references them by GUID, so a fresh clone needs them present.
# A copy worth keeping lives in docs/evidence/app_icon_sizes.png.
UnityMCPProject/Assets/Mobile/Art/icon_size_preview.png
UnityMCPProject/Assets/Mobile/Art/icon_size_preview.png.meta

# Unity's asset-store importer scratch
UnityMCPProject/Assets/AssetStoreTools*
UnityMCPProject/Assets/StreamingAssets/aa*
# Raw CC0 asset downloads (kept locally for provenance, never committed).
.assets/
